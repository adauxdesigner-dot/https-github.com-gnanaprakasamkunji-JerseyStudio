{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JerseyStudio",
  "version": "0.1.0",
  "identifier": "com.jerseystudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JerseyStudio",
        "width": 1280,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.jerseystudio.app",
    "shortDescription": "Local-first jersey design and bulk personalization desktop studio",
    "longDescription": "JerseyStudio is a local-first desktop application for athletic jersey design and bulk team personalization. All designs, templates, player rosters, generated previews, and production exports remain 100% on the user's local device.",
    "copyright": "Copyright © 2026 JerseyStudio. All rights reserved.",
    "category": "Graphics & Design",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macos": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "category": "public.app-category.graphics-design",
      "dmg": {
        "windowPosition": {
          "x": 400,
          "y": 300
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "en-US"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
